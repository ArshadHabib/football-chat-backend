# Reference only: real names, dummy values. Copy to .env and put the real values
# there. Real values live only in each server's .env; never commit them.

PORT=5008
CORS_ORIGINS=http://localhost:8089,http://localhost:3021
MONGO_URI=mongodb://127.0.0.1:27017/sports
MONGO_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
REDIS_URL=redis://127.0.0.1:6379
# The backend, for checking admin logins.
BACKEND_API=http://localhost:5007
# AI moderation (optional; off without it).
GEMINI_API_KEY=dummy-gemini-key-change-me
# The key the backend sends with every call (the backend's CHAT_ADMIN_KEY).
CHAT_ADMIN_KEY=dummy-chat-admin-key-change-me
